{
  "name": "synwave",
  "private": true,
  "version": "1.0.0",
  "description": "Synwave — Open-source procedural audio-reactive music visualizer and local audio player",
  "type": "module",
  "scripts": {
    "start": "bash start.sh",
    "dev": "bash start.sh",
    "dev:frontend": "vite",
    "dev:shazam": "source .venv/bin/activate && python3 shazam_server.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
